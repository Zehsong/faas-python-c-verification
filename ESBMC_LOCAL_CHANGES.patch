+
+// Experimental Python<->C relational-verification bridge.
+//
+// A C relational harness calls:
+//
+//     __ESBMC_PY_TARGET(...)
+//
+// which appears in GOTO as:
+//
+//     c:@F@__ESBMC_PY_TARGET
+//
+// After Python and C GOTO binaries have been merged, redirect that call
+// to the unique Python function requested by:
+//
+//     --equiv-py-target <name>
+//
+// This changes only the call target.  The Python function body itself is
+// the real GOTO body produced by the Python frontend.
+static bool retarget_equiv_python_placeholder(
+  const cmdlinet &cmdline,
+  goto_functionst &goto_functions)
+{
+  if (!cmdline.isset("equiv-py-target"))
+    return false;
+
+  const std::string wanted = cmdline.getval("equiv-py-target");
+  const std::string suffix = "@F@" + wanted;
+
+  irep_idt python_target;
+  std::size_t matches = 0;
+
+  for (const auto &entry : goto_functions.function_map)
+  {
+    const std::string id = entry.first.as_string();
+
+    const bool is_python =
+      id.rfind("py:", 0) == 0;
+
+    const bool suffix_matches =
+      id.size() >= suffix.size() &&
+      id.compare(
+        id.size() - suffix.size(),
+        suffix.size(),
+        suffix) == 0;
+
+    if (is_python && suffix_matches)
+    {
+      python_target = entry.first;
+      ++matches;
+    }
+  }
+
+  if (matches != 1)
+  {
+    log_error(
+      "relational bridge expected exactly one Python function named `{}`, "
+      "found {}",
+      wanted,
+      matches);
+    return true;
+  }
+
+  const irep_idt placeholder("c:@F@__ESBMC_PY_TARGET");
+
+  std::size_t rewrites = 0;
+
+  for (auto &entry : goto_functions.function_map)
+  {
+    Forall_goto_program_instructions (it, entry.second.body)
+    {
+      if (!it->is_function_call())
+        continue;
+
+      code_function_call2t &call =
+        to_code_function_call2t(it->code);
+
+      if (
+        is_symbol2t(call.function) &&
+        to_symbol2t(call.function).thename == placeholder)
+      {
+        call.function =
+          symbol2tc(get_empty_type(), python_target);
+
+        ++rewrites;
+      }
+    }
+  }
+
+  if (rewrites == 0)
+  {
+    log_error(
+      "relational bridge found no calls to `{}`",
+      id2string(placeholder));
+    return true;
+  }
+
+  log_status(
+    "Relational bridge: retargeted {} call(s) from `{}` to `{}`",
+    rewrites,
+    id2string(placeholder),
+    id2string(python_target));
+
+  return false;
+}
+
+
+// Experimental C side of the Python<->C relational bridge.
+//
+// The synthetic relational harness calls:
+//
+//     __ESBMC_C_TARGET(...)
+//
+// instead of declaring/calling the real C function directly.
+//
+// This is important when multiple GOTO binaries are merged: a second extern
+// declaration of the real C function can overwrite goto_functiont::type
+// metadata (including formal-parameter identifiers) while leaving the body
+// from the original C binary.  Retargeting a uniquely named placeholder keeps
+// the C function's body and type together.
+static bool retarget_equiv_c_placeholder(
+  const cmdlinet &cmdline,
+  goto_functionst &goto_functions)
+{
+  if (!cmdline.isset("equiv-c-target"))
+    return false;
+
+  const std::string wanted = cmdline.getval("equiv-c-target");
+
+  irep_idt c_target;
+
+  // Prefer the normal external C function id.
+  const irep_idt exact("c:@F@" + wanted);
+
+  auto exact_it = goto_functions.function_map.find(exact);
+
+  if (
+    exact_it != goto_functions.function_map.end() &&
+    exact_it->second.body_available)
+  {
+    c_target = exact;
+  }
+  else
+  {
+    // Fallback for file-local/static functions: require a unique bodied
+    // C function whose id ends in @F@<wanted>.
+    const std::string suffix = "@F@" + wanted;
+
+    std::size_t matches = 0;
+
+    for (const auto &entry : goto_functions.function_map)
+    {
+      const std::string id = entry.first.as_string();
+
+      const bool is_c =
+        id.rfind("c:", 0) == 0;
+
+      const bool suffix_matches =
+        id.size() >= suffix.size() &&
+        id.compare(
+          id.size() - suffix.size(),
+          suffix.size(),
+          suffix) == 0;
+
+      if (
+        is_c &&
+        suffix_matches &&
+        entry.second.body_available)
+      {
+        c_target = entry.first;
+        ++matches;
+      }
+    }
+
+    if (matches != 1)
+    {
+      log_error(
+        "relational bridge expected exactly one bodied C function "
+        "named `{}`, found {}",
+        wanted,
+        matches);
+      return true;
+    }
+  }
+
+  const irep_idt placeholder("c:@F@__ESBMC_C_TARGET");
+
+  std::size_t rewrites = 0;
+
+  for (auto &entry : goto_functions.function_map)
+  {
+    Forall_goto_program_instructions (it, entry.second.body)
+    {
+      if (!it->is_function_call())
+        continue;
+
+      code_function_call2t &call =
+        to_code_function_call2t(it->code);
+
+      if (
+        is_symbol2t(call.function) &&
+        to_symbol2t(call.function).thename == placeholder)
+      {
+        call.function =
+          symbol2tc(get_empty_type(), c_target);
+
+        ++rewrites;
+      }
+    }
+  }
+
+  if (rewrites == 0)
+  {
+    log_error(
+      "relational bridge found no calls to `{}`",
+      id2string(placeholder));
+    return true;
+  }
+
+  log_status(
+    "Relational bridge: retargeted {} C call(s) from `{}` to `{}`",
+    rewrites,
+    id2string(placeholder),
+    id2string(c_target));
+
+  return false;
+}
