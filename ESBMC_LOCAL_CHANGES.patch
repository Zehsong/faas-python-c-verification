@@ -336,6 +569,22 @@ bool esbmc_parseoptionst::read_goto_binary(goto_functionst &goto_functions)
 {
   log_progress("Reading GOTO program from file");
   goto_binary_reader goto_reader;
+
+  // Experimental relational-linking rule:
+  //
+  // The Python frontend's __ESBMC_main is semantically significant: it
+  // initializes static-lifetime state, invokes python_init(), and executes
+  // python_user_main().  A later C relational harness also owns an
+  // __ESBMC_main, so ordinary multi-binary merging overwrites the Python
+  // entry and makes runtime-backed Python values (list/dict/str/...) execute
+  // without initialization.
+  //
+  // In relational mode the first input is the Python GOTO binary. Preserve
+  // its complete entry body under a collision-free callable alias before
+  // reading the later C/harness binaries.
+  const irep_idt py_module_entry = "c:@F@__ESBMC_PY_MODULE_ENTRY";
+  bool first_binary = true;
+
   for (const auto &arg : cmdline.args)
   {
     if (goto_reader.read_goto_binary(arg, context, goto_functions))
@@ -343,6 +592,35 @@ bool esbmc_parseoptionst::read_goto_binary(goto_functionst &goto_functions)
       log_error("Failed to read `{}'", arg);
       return true;
     }
+
+    if (first_binary && cmdline.isset("equiv-py-target"))
+    {
+      auto py_main = goto_functions.function_map.find("__ESBMC_main");
+
+      if (
+        py_main == goto_functions.function_map.end() ||
+        !py_main->second.body_available)
+      {
+        log_error(
+          "Relational bridge: Python binary has no bodied __ESBMC_main "
+          "to preserve");
+        return true;
+      }
+
+      goto_functions.function_map[py_module_entry] = py_main->second;
+
+      // The copied instructions still carry the old owning-function id.
+      // Rewrite only instruction ownership metadata; function-call targets
+      // inside the body (python_init, python_user_main, hooks) remain intact.
+      goto_functions.function_map[py_module_entry]
+        .update_instructions_function(py_module_entry, true);
+
+      log_status(
+        "Relational bridge: preserved Python module entry as `{}`",
+        id2string(py_module_entry));
+    }
+
+    first_binary = false;
   }
 
   return false;
