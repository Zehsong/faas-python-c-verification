#!/usr/bin/env python3

import argparse
import re
import subprocess
import sys
import time
from pathlib import Path


DEFAULT_ESBMC = "/workspaces/esbmc-current/build/src/esbmc/esbmc"


# ---------------------------------------------------------------------------
# CLI / type model
# ---------------------------------------------------------------------------

SUPPORTED_TYPES = {"int", "bool"}

PY_C_TYPES = {
    "int": "long",
    "bool": "_Bool",
}

TARGET_C_TYPES = {
    "int": "int",
    "bool": "_Bool",
}


def parse_param(text):
    if ":" not in text:
        raise argparse.ArgumentTypeError(
            f"parameter must be NAME:TYPE, got {text!r}"
        )

    name, typ = text.split(":", 1)
    name = name.strip()
    typ = typ.strip()

    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        raise argparse.ArgumentTypeError(
            f"invalid parameter name: {name!r}"
        )

    if typ not in SUPPORTED_TYPES:
        raise argparse.ArgumentTypeError(
            f"unsupported parameter type {typ!r}; "
            f"supported: {sorted(SUPPORTED_TYPES)}"
        )

    return name, typ


def validate_identifier(name, what):
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        raise SystemExit(
            f"UNKNOWN\nReason: v0 requires a simple module-level "
            f"{what} identifier, got {name!r}"
        )


# ---------------------------------------------------------------------------
# Process execution
# ---------------------------------------------------------------------------

def run(cmd, logfile, timeout):
    logfile = Path(logfile)

    # Record the exact command for reproducibility/debugging.
    with logfile.open("w") as trace:
        trace.write(
            "VERIFY_EQUIV_COMMAND: "
            + " ".join(str(x) for x in cmd)
            + "\n"
        )

    try:
        with logfile.open("a") as out:
            proc = subprocess.run(
                cmd,
                stdout=out,
                stderr=subprocess.STDOUT,
                text=True,
                timeout=timeout,
            )

        return proc.returncode, False

    except subprocess.TimeoutExpired:
        with logfile.open("a") as out:
            out.write(
                f"\nVERIFY_EQUIV_INTERNAL: timeout after {timeout}s\n"
            )
        return 124, True


def tail_interesting(path, limit=25):
    path = Path(path)

    if not path.exists():
        return []

    patterns = (
        "ERROR",
        "Unsupported",
        "unsupported",
        "TypeError",
        "NotImplementedError",
        "no body",
        "Failed",
        "failed",
        "relational bridge",
    )

    lines = path.read_text(errors="replace").splitlines()

    interesting = [
        line for line in lines
        if any(p in line for p in patterns)
    ]

    return interesting[-limit:]


def export_goto(esbmc, source, output, log, timeout):
    rc, timed_out = run(
        [
            esbmc,
            str(source),
            "--output-goto",
            str(output),
        ],
        log,
        timeout,
    )

    if timed_out:
        return False, "TIMEOUT"

    #
    # Current ESBMC returns 6 after --output-goto because
    # output_goto_program() terminates the get_goto_program path.
    #
    # The file is therefore the authoritative success signal.
    #
    if output.exists() and output.stat().st_size > 0:
        return True, f"export_rc={rc}"

    return False, f"export failed, rc={rc}"


# ---------------------------------------------------------------------------
# Harness generation
# ---------------------------------------------------------------------------

def build_harness(py_function, c_function, params, return_type):
    py_ret = PY_C_TYPES[return_type]
    c_ret = TARGET_C_TYPES[return_type]

    py_decl_args = []
    c_decl_args = []

    declarations = []
    py_call_args = []
    c_call_args = []

    for name, typ in params:
        py_type = PY_C_TYPES[typ]
        c_type = TARGET_C_TYPES[typ]

        py_decl_args.append(f"{py_type} {name}")
        c_decl_args.append(f"{c_type} {name}")

        if typ == "int":
            #
            # Shared logical input:
            #
            #     symbolic C int32
            #           |
            #           +----> C int
            #           |
            #           +----> Python long
            #
            declarations.append(
                f"    int {name} = __VERIFIER_nondet_int();"
            )
            py_call_args.append(f"(long){name}")
            c_call_args.append(name)

        elif typ == "bool":
            #
            # Generate one symbolic Boolean value from nondet int.
            #
            declarations.append(
                f"    _Bool {name} = "
                f"(__VERIFIER_nondet_int() != 0);"
            )
            py_call_args.append(name)
            c_call_args.append(name)

    py_decl = ", ".join(py_decl_args) if py_decl_args else "void"
    c_decl = ", ".join(c_decl_args) if c_decl_args else "void"

    py_args = ", ".join(py_call_args)
    c_args = ", ".join(c_call_args)

    body_decls = "\n".join(declarations)

    return f'''/*
 * AUTO-GENERATED BY verify-equiv v0.
 *
 * Do not treat __ESBMC_PY_TARGET as an implementation.
 * The relational bridge retargets this placeholder to the
 * real Python GOTO function after binary merge.
 */

extern int __VERIFIER_nondet_int(void);

extern {py_ret} __ESBMC_PY_TARGET({py_decl});
extern {c_ret} {c_function}({c_decl});

int equiv_main(void)
{{
{body_decls}

    long r_py = (long)__ESBMC_PY_TARGET({py_args});
    long r_c  = (long){c_function}({c_args});

    __ESBMC_assert(
        r_py == r_c,
        "__VERIFY_EQUIV_RELATIONAL_PROPERTY__"
    );

    return 0;
}}

int main(void)
{{
    return equiv_main();
}}
'''


# ---------------------------------------------------------------------------
# Result extraction
# ---------------------------------------------------------------------------

def extract_counterexample(logfile, params):
    lines = Path(logfile).read_text(errors="replace").splitlines()

    wanted = [name for name, _ in params] + ["r_py", "r_c"]

    result = []

    for line in lines:
        stripped = line.strip()

        for name in wanted:
            if re.match(
                rf"^{re.escape(name)}\s*=",
                stripped
            ):
                if stripped not in result:
                    result.append(stripped)

    return result


def classify_verification(logfile, rc):
    text = Path(logfile).read_text(errors="replace")

    if "VERIFICATION SUCCESSFUL" in text:
        return "EQ"

    if "VERIFICATION FAILED" in text:
        return "NEQ"

    return "UNKNOWN"


# ---------------------------------------------------------------------------
# Main checker
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="verify-equiv",
        description=(
            "Experimental Python<->C relational equivalence checker "
            "using ESBMC common GOTO IR."
        ),
    )

    parser.add_argument("--python", required=True)
    parser.add_argument("--py-function", required=True)

    parser.add_argument("--c", required=True)
    parser.add_argument("--c-function", required=True)

    parser.add_argument(
        "--param",
        action="append",
        type=parse_param,
        default=[],
        help="logical scalar parameter NAME:TYPE; TYPE=int|bool",
    )

    parser.add_argument(
        "--return",
        dest="return_type",
        choices=sorted(SUPPORTED_TYPES),
        required=True,
    )

    parser.add_argument(
        "--esbmc",
        default=DEFAULT_ESBMC,
    )

    parser.add_argument(
        "--unwind",
        type=int,
        default=12,
    )

    parser.add_argument(
        "--timeout",
        type=int,
        default=120,
    )

    parser.add_argument(
        "--workdir",
        default=None,
        help="preserve intermediate GOTO/log files here",
    )

    args = parser.parse_args()

    py_file = Path(args.python).resolve()
    c_file = Path(args.c).resolve()
    esbmc = str(Path(args.esbmc).resolve())

    validate_identifier(args.py_function, "Python function")
    validate_identifier(args.c_function, "C function")

    if not py_file.exists():
        print("UNKNOWN")
        print(f"Reason: Python file not found: {py_file}")
        return 2

    if not c_file.exists():
        print("UNKNOWN")
        print(f"Reason: C file not found: {c_file}")
        return 2

    if not Path(esbmc).exists():
        print("UNKNOWN")
        print(f"Reason: ESBMC binary not found: {esbmc}")
        return 2

    #
    # Make sure we are using our relationally-enabled ESBMC build.
    #
    try:
        help_text = subprocess.check_output(
            [esbmc, "--help"],
            text=True,
            stderr=subprocess.STDOUT,
            timeout=20,
        )
    except Exception as exc:
        print("UNKNOWN")
        print(f"Reason: could not execute ESBMC: {exc}")
        return 2

    if "equiv-py-target" not in help_text:
        print("UNKNOWN")
        print(
            "Reason: this ESBMC build does not contain "
            "--equiv-py-target"
        )
        return 2

    if args.workdir:
        workdir = Path(args.workdir).resolve()
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        workdir = (
            Path.cwd()
            / ".verify-equiv-runs"
            / f"{args.py_function}__{args.c_function}__{stamp}"
        )

    workdir.mkdir(parents=True, exist_ok=True)

    py_gb = workdir / "python.gb"
    c_gb = workdir / "c.gb"
    harness_gb = workdir / "harness.gb"

    harness_c = workdir / "equiv_harness.c"

    py_log = workdir / "python_export.log"
    c_log = workdir / "c_export.log"
    harness_log = workdir / "harness_export.log"
    verify_log = workdir / "verification.log"

    #
    # Generate relational harness.
    #
    harness_c.write_text(
        build_harness(
            args.py_function,
            args.c_function,
            args.param,
            args.return_type,
        )
    )

    #
    # Export Python GOTO.
    #
    ok, reason = export_goto(
        esbmc,
        py_file,
        py_gb,
        py_log,
        args.timeout,
    )

    if not ok:
        print("UNKNOWN")
        print(f"Reason: Python frontend/GOTO export: {reason}")
        for line in tail_interesting(py_log):
            print(f"  {line}")
        print(f"Artifacts: {workdir}")
        return 2

    #
    # Export C GOTO.
    #
    ok, reason = export_goto(
        esbmc,
        c_file,
        c_gb,
        c_log,
        args.timeout,
    )

    if not ok:
        print("UNKNOWN")
        print(f"Reason: C frontend/GOTO export: {reason}")
        for line in tail_interesting(c_log):
            print(f"  {line}")
        print(f"Artifacts: {workdir}")
        return 2

    #
    # Export synthetic relational harness.
    #
    ok, reason = export_goto(
        esbmc,
        harness_c,
        harness_gb,
        harness_log,
        args.timeout,
    )

    if not ok:
        print("UNKNOWN")
        print(f"Reason: harness GOTO export: {reason}")
        for line in tail_interesting(harness_log):
            print(f"  {line}")
        print(f"Artifacts: {workdir}")
        return 2

    #
    # One relational verification problem:
    #
    #     python.gb
    #         +
    #     harness.gb
    #         +
    #       c.gb
    #
    # The same logical symbolic inputs flow to both functions.
    #
    verify_cmd = [
        esbmc,
        "--binary",
        str(py_gb),
        str(harness_gb),
        str(c_gb),
        "--equiv-py-target",
        args.py_function,
        "--function",
        "c:@F@equiv_main",
        "--unwind",
        str(args.unwind),

        #
        # C correctness is part of the equivalence obligation.
        #
        "--overflow-check",
    ]

    rc, timed_out = run(
        verify_cmd,
        verify_log,
        args.timeout,
    )

    if timed_out:
        print("UNKNOWN")
        print(f"Reason: verification timeout ({args.timeout}s)")
        print(f"Artifacts: {workdir}")
        return 2

    verdict = classify_verification(verify_log, rc)

    if verdict == "EQ":
        print("EQ")
        print()
        print("Proof scope:")

        if not args.param:
            print("  no symbolic parameters")

        for name, typ in args.param:
            if typ == "int":
                print(
                    f"  {name}: shared int32 domain "
                    f"[-2147483648, 2147483647]"
                )
            else:
                print(f"  {name}: boolean {{False, True}}")

        print(
            "  semantics: ESBMC Python/C modeled semantics"
        )

        print(
            f"  unwind bound: {args.unwind} "
            "(relevant only if reachable loops/recursion exist)"
        )

        print()
        print(f"Artifacts: {workdir}")
        return 0

    if verdict == "NEQ":
        print("NEQ")

        cex = extract_counterexample(
            verify_log,
            args.param,
        )

        if cex:
            print()
            print("Counterexample:")
            for line in cex:
                print(f"  {line}")

        #
        # Show the violated property, including possible C safety failures.
        #
        text = verify_log.read_text(errors="replace").splitlines()

        violations = []

        for i, line in enumerate(text):
            if "Violated property:" in line:
                violations.extend(text[i:i + 8])

        if violations:
            print()
            print("Violation:")
            for line in violations[-12:]:
                if line.strip():
                    print(f"  {line.strip()}")

        print()
        print(f"Artifacts: {workdir}")
        return 1

    print("UNKNOWN")
    print(f"Reason: ESBMC did not produce a definitive verdict (rc={rc})")

    for line in tail_interesting(verify_log):
        print(f"  {line}")

    print(f"Artifacts: {workdir}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
